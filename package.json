{
  "name": "elawatan-perak",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistem Permohonan dan Kelulusan Lawatan Murid Sekolah — JPN Perak",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:mula": "supabase start",
    "db:henti": "supabase stop",
    "db:tolak": "supabase db push",
    "db:set-semula": "supabase db reset",
    "db:jenis": "supabase gen types typescript --local > src/lib/jenis-db.ts",
    "fn:hidang": "supabase functions serve --env-file supabase/functions/.env",
    "fn:tabur": "supabase functions deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "date-fns": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
