# ── Frontend (Vite) ──────────────────────────────────────────────
# Salin fail ini ke `.env` dan isi nilai sebenar.
# Semua VITE_* terdedah kepada pelayar — JANGAN letak service key di sini.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Domain e-mel yang dibenarkan log masuk (dipisah koma)
VITE_DOMAIN_DIBENARKAN=moe-dl.edu.my,moe.edu.my,moe.gov.my

# URL asas untuk kod QR surat kelulusan
VITE_URL_SISTEM=https://lawatan.jpnperak.gov.my
